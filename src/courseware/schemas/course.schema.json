{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Courseware course.json v1.0",
  "description": "课程仓库元数据结构契约；跨实体引用、实际文件与发布安全边界需按课程仓库标准另行校验。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "slug": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/title"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true
    },
    "level": {
      "enum": [
        "introductory",
        "intermediate",
        "advanced"
      ]
    },
    "entry": {
      "$ref": "#/$defs/htmlPath"
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/image"
      },
      "minItems": 1,
      "maxItems": 100,
      "contains": {
        "properties": {
          "role": {
            "const": "cover"
          }
        },
        "required": [
          "role"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "creators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/creator"
      },
      "minItems": 1,
      "maxItems": 100,
      "contains": {
        "properties": {
          "roles": {
            "contains": {
              "const": "author"
            }
          }
        },
        "required": [
          "roles"
        ]
      },
      "minContains": 1
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "chapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chapter"
      },
      "minItems": 0,
      "maxItems": 500
    },
    "lessons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lesson"
      },
      "minItems": 1,
      "maxItems": 1000,
      "contains": {
        "properties": {
          "status": {
            "const": "published"
          }
        },
        "required": [
          "status"
        ]
      },
      "minContains": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "publish": {
      "$ref": "#/$defs/publish"
    }
  },
  "required": [
    "schema_version",
    "slug",
    "title",
    "summary",
    "description",
    "language",
    "tags",
    "entry",
    "images",
    "creators",
    "groups",
    "chapters",
    "lessons",
    "resources",
    "publish"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "htmlPath": {
      "allOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "pattern": "\\.html$"
        }
      ]
    },
    "imagePath": {
      "allOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "pattern": "\\.(png|jpg|jpeg|webp|gif)$"
        }
      ]
    },
    "ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "imageFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/imagePath"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "path",
        "alt"
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "cover",
            "gallery"
          ]
        },
        "path": {
          "$ref": "#/$defs/imagePath"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "role",
        "path",
        "alt"
      ]
    },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "author",
              "instructor",
              "editor",
              "reviewer"
            ]
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "organization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "team": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "bio": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "avatar": {
          "$ref": "#/$defs/imageFile"
        }
      },
      "required": [
        "id",
        "name",
        "roles"
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "summary": {
          "$ref": "#/$defs/summary"
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "parent_id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "group_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "theory",
            "lab",
            "project",
            "reading"
          ]
        },
        "chapter_ids": {
          "$ref": "#/$defs/ids"
        },
        "creator_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "published",
            "planned"
          ]
        },
        "entry": {
          "$ref": "#/$defs/htmlPath"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true
        },
        "duration_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "cover_image_id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "id",
        "title",
        "summary",
        "group_id",
        "kind",
        "chapter_ids",
        "creator_ids",
        "status",
        "keywords"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "published"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "entry"
            ]
          },
          "else": {
            "not": {
              "required": [
                "entry"
              ]
            }
          }
        }
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "kind": {
          "enum": [
            "code",
            "dataset",
            "document"
          ]
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "lesson_ids": {
          "$ref": "#/$defs/ids"
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "path",
        "lesson_ids"
      ]
    },
    "publishPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:web|assets|lessons)/(?:[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*/?)?$"
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publishPath"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        }
      },
      "required": [
        "include"
      ]
    }
  }
}
